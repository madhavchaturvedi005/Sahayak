# Sahayak CPGRAMS — production .env for EC2 deploy
# Copy to .env on the server, fill the required values, then run: ./deploy.sh
#
# deploy.sh auto-fills PUBLIC_URL / FRONTEND_URL / NEXT_PUBLIC_API_URL / DATABASE_URL
# from your Elastic IP (https://52-1-2-3.sslip.io) unless you set PUBLIC_URL yourself.

APP_ENV=production
LOG_LEVEL=INFO
NODE_ENV=production
FRONTEND_TARGET=prod

# --- Required: change these before deploy ---
POSTGRES_USER=sahayak
# Use letters and numbers only (no @ : / #) so DATABASE_URL stays valid.
# If you use @ or other special chars, deploy.sh URL-encodes them automatically.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=sahayak_db

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# --- Optional: officer desk seed (defaults are fine for hackathon demo) ---
ADMIN_NAME=Nodal Administrator
ADMIN_MOBILE=9999999999
ADMIN_EMAIL=pg.admin@cpgrams.gov.in

# --- Optional: override auto-detected public URL ---
# Use this if you bought a custom domain instead of sslip.io:
# PUBLIC_URL=https://sahayak-demo.example.in

# --- Leave blank — deploy.sh sets these from PUBLIC_URL / POSTGRES_* ---
# FRONTEND_URL=
# NEXT_PUBLIC_API_URL=
# DATABASE_URL=
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

NEXT_PUBLIC_BASE_PATH=

OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
JWT_EXPIRE_MINUTES=10080

GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
