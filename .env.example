# Sahayak CPGRAMS — local environment
# Copy to .env and adjust as needed.

APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3001

POSTGRES_USER=sahayak
POSTGRES_PASSWORD=sahayak
POSTGRES_DB=sahayak_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sahayak:sahayak@postgres:5432/sahayak_db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Officer desk — seeded on backend start. Sign in at /admin/signin.
ADMIN_NAME=Nodal Administrator
ADMIN_MOBILE=9999999999
ADMIN_EMAIL=pg.admin@cpgrams.gov.in
ADMIN_PASSWORD=cpgrams-admin

NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=
NODE_ENV=development
FRONTEND_TARGET=dev

# Avatar voice: paste your OpenAI key, then restart the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional extra model. Leave empty if unused.
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
